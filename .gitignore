# =============================================================================
# EasyReportCreator — keep the repo source-only; large/local assets stay local
# =============================================================================

# --- Local toolchains (portable PHP, etc.) — never commit ---
.tools/

# --- Plant 3D sample projects (local only; .dcf and full project trees) ---
# Ignore all sample content, then allow only README.md files for docs.
samples/**
!samples/**/
!samples/README.md
!samples/**/README.md

# Extra safety if a sample folder is force-added:
samples/**/*.xml
samples/**/*.txt
samples/**/*.dwg
samples/**/*.dcf
samples/**/*.bak
samples/**/*.lock
samples/**/Isometric/**
samples/**/Orthos/**
samples/**/PID*/**
samples/**/ReportFiles/**
samples/**/ReportTemplates/**
samples/**/StringTables/**
samples/**/ImportExportSettings/**
samples/**/Project Recycle Bin/**

# --- Reference material (correspondence, demo video, large assets) ---
reference/correspondence/
reference/media/
reference/**/*.mp4
reference/**/*.mov
reference/**/*.avi
reference/**/*.pdf

# Chat exports (may appear outside reference/)
*[Cc]hat*[Hh]istory*
*chat*history*

# --- Report app runtime data (state, logo, uploads, exports, auth DB) ---
app/data/*
!app/data/.gitkeep
website/data/*
!website/data/.gitkeep
!website/data/.htaccess
!website/data/web.config
!website/data/uploads/
website/data/uploads/*
!website/data/uploads/.gitkeep
!website/data/uploads/.htaccess
!website/data/uploads/web.config
website/data/companies/
website/data/auth.sqlite
website/data/auth.sqlite-*
website/data/*.sqlite
website/data/logo.png
website/data/logo.jpg
website/data/logo.jpeg
website/data/logo.webp

# SQLite / local DBs anywhere
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# --- Generated Excel / Office exports ---
*.xlsx
*.xls
*.xlsm

# --- Plant 3D / AutoCAD binaries (if placed outside samples/) ---
*.dcf
*.dwg
*.bak
*.dwt
*.dwl
*.dwl2
*.pcf
*.isf
Project.xml.lock
projSymbolStyle.bak
projSymbolStyle.dwg

# Safe demo write-back copy (never commit real project DCF)
*demo-writeback*

# --- Office binaries (markdown sources in docs/ are kept) ---
*.docx
*.doc
~$*

# --- Environment & secrets / deploy helpers ---
.env
.env.*
!.env.example
*.pem
*.key
*_ssh_*.py
*_deploy_*.py
*credentials*
*secrets*

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- Editors & IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# --- Logs & temp ---
*.log
*.tmp
*.temp
.cache/
*.pid
*.seed
*.cookie
*cookies*.txt
erc-*-cookies.txt

# --- PHP / web (local preview artefacts) ---
vendor/
!app/static/vendor/
!app/static/vendor/**
composer.phar
php.ini
php_errors.log
session_data/
# PHP session files that may appear under website/
website/**/sess_*

# --- Node (if added later) ---
node_modules/
npm-debug.log*
yarn-error.log*

# --- Archives / deploy packs (manual drops, backups) ---
*.zip
*.7z
*.rar
*.tar
*.gz
*.tgz
website-staging/
