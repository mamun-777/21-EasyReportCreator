# =============================================================================
# EasyReportCreator — keep the repo source-only; large/local assets stay local
# =============================================================================

# --- Local toolchains (portable PHP, etc.) — never commit ---
.tools/

# --- Plant 3D project folders (copy locally; ~60 MB+ per project) ---
samples/*
!samples/README.md

# --- Reference material (correspondence, demo video) ---
reference/correspondence/
reference/media/

# Chat exports (may appear outside reference/)
*[Cc]hat*[Hh]istory*
*chat*history*

# --- Report app runtime data (state, logo, uploads, exports) ---
app/data/*
!app/data/.gitkeep
website/data/*
!website/data/.gitkeep
!website/data/.htaccess
!website/data/web.config
!website/data/uploads/
website/data/uploads/*
!website/data/uploads/.gitkeep
!website/data/uploads/.htaccess
!website/data/uploads/web.config

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# --- Generated Excel exports ---
*.xlsx

# --- Plant 3D / AutoCAD binaries (if placed outside samples/) ---
*.dcf
*.dwg
*.bak
*.dwt
*.dwl
*.dwl2
*.pcf
*.isf
Project.xml.lock
projSymbolStyle.bak

# Safe demo write-back copy (never commit real project DCF)
*demo-writeback*

# --- Office binaries (markdown sources in docs/ are kept) ---
*.docx
*.doc
~$*

# --- Environment & secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- Editors & IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# --- Logs & temp ---
*.log
*.tmp
*.temp
.cache/
*.pid
*.seed

# --- PHP / web (local preview artefacts) ---
vendor/
!app/static/vendor/
!app/static/vendor/**
composer.phar
php.ini
php_errors.log
session_data/
# PHP session files that may appear under website/
website/**/sess_*

# --- Node (if added later) ---
node_modules/
npm-debug.log*
yarn-error.log*

# --- Archives (manual drops, backups) ---
*.zip
*.7z
*.rar
*.tar
*.gz
